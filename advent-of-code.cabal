cabal-version:      3.0
name:               advent-of-code
version:            0.1.0.0
synopsis:           Advent of Code solutions for 12 days
category:           Algorithms
description:        Per-day solution libraries, a command-line runner, and sample tests.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Tony Bradley
maintainer:         antbradley91@gmail.com
build-type:         Simple
extra-doc-files:
    CHANGELOG.md
    README.md

common defaults
    ghc-options:      -Wall
    default-language: Haskell2010
    default-extensions:
        OverloadedStrings,
        LambdaCase,
        TypeApplications,
        ImportQualifiedPost,
        TupleSections,
        MultilineStrings
    build-depends:
        base >=4.18 && <5,
        bytestring >=0.11 && <0.13,
        relude ^>=1.2.2.2
    mixins:
        base hiding (Prelude),
        relude (Relude as Prelude),
        relude

common all-days
    build-depends:
        advent-of-code:day01,
        advent-of-code:day02,
        advent-of-code:day03,
        advent-of-code:day04,
        advent-of-code:day05,
        advent-of-code:day06,
        advent-of-code:day07,
        advent-of-code:day08,
        advent-of-code:day09,
        advent-of-code:day10,
        advent-of-code:day11,
        advent-of-code:day12

library day01
    import:           defaults
    exposed-modules:  Day01
    hs-source-dirs:   lib/day01

library day02
    import:           defaults
    exposed-modules:  Day02
    hs-source-dirs:   lib/day02

library day03
    import:           defaults
    exposed-modules:  Day03
    hs-source-dirs:   lib/day03

library day04
    import:           defaults
    exposed-modules:  Day04
    hs-source-dirs:   lib/day04

library day05
    import:           defaults
    exposed-modules:  Day05
    hs-source-dirs:   lib/day05

library day06
    import:           defaults
    exposed-modules:  Day06
    hs-source-dirs:   lib/day06

library day07
    import:           defaults
    exposed-modules:  Day07
    hs-source-dirs:   lib/day07

library day08
    import:           defaults
    exposed-modules:  Day08
    hs-source-dirs:   lib/day08

library day09
    import:           defaults
    exposed-modules:  Day09
    hs-source-dirs:   lib/day09

library day10
    import:           defaults
    exposed-modules:  Day10
    hs-source-dirs:   lib/day10

library day11
    import:           defaults
    exposed-modules:  Day11
    hs-source-dirs:   lib/day11

library day12
    import:           defaults
    exposed-modules:  Day12
    hs-source-dirs:   lib/day12

executable advent-of-code
    import:           defaults, all-days
    main-is:          Main.hs
    other-modules:
        Days
        Options
    hs-source-dirs:   app

executable test
    import:           defaults, all-days
    main-is:          Main.hs
    other-modules:
        TestSupport
        Day01Test
        Day02Test
        Day03Test
        Day04Test
        Day05Test
        Day06Test
        Day07Test
        Day08Test
        Day09Test
        Day10Test
        Day11Test
        Day12Test
    hs-source-dirs:   test
